# Copy this file to .env and set your password before building/deploying.
# Generate a strong password — this is the only thing protecting your app.
#
# Example:  VITE_AUTH_PASSWORD=correct-horse-battery-staple
#
# HOW IT WORKS:
#  1. Deploy the app.
#  2. Open the app URL on each trusted device → you'll see the login page.
#  3. Enter the password → the app generates a unique token for that device and
#     redirects to  ?token=<value>  — BOOKMARK this URL on the device.
#  4. Every future visit via the bookmarked URL → no login needed.

VITE_AUTH_PASSWORD= Password for the login
